# syntax=docker/dockerfile:1
# check=error=true

ARG RUBY_IMAGE_TAG=3-debian

# Resolve runtime packages separately; keep APT and compilers out of production.
FROM dhi.io/ruby:${RUBY_IMAGE_TAG} AS runtime-base
FROM dhi.io/ruby:${RUBY_IMAGE_TAG}-dev AS runtime-packages
COPY --from=runtime-base /var/lib/dpkg/status /tmp/base-package-status
COPY docker/runtime-packages /tmp/runtime-packages
RUN --mount=type=cache,id=som-apt-lists,target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=som-apt-cache,target=/var/cache/apt,sharing=locked \
    bash /tmp/runtime-packages

FROM dhi.io/ruby:${RUBY_IMAGE_TAG}-dev AS build
WORKDIR /rails
ENV RAILS_ENV=production \
    BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_WITHOUT=development:test \
    BUNDLE_DEPLOYMENT=1
ARG BUILD_JOBS=4
RUN --mount=type=cache,id=som-apt-lists,target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=som-apt-cache,target=/var/cache/apt,sharing=locked \
    apt-get update -qq && apt-get install --no-install-recommends -y gzip libpq-dev libyaml-dev pkg-config
COPY Gemfile Gemfile.lock ./
RUN gem install bundler -v 4.0.20 --no-document
RUN --mount=type=cache,id=som-gem-cache,target=/usr/local/bundle/cache \
    bundle install --jobs ${BUILD_JOBS} && \
    bundle exec bootsnap precompile --gemfile
COPY . .
RUN bundle exec bootsnap precompile app/ lib/ && \
    SECRET_KEY_BASE_DUMMY=1 ./bin/rails assets:precompile && \
    mkdir -p db log storage tmp /runtime-dirs && \
    mv db log storage tmp /runtime-dirs/

FROM runtime-base AS runtime
WORKDIR /rails
ENV RAILS_ENV=production \
    BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_WITHOUT=development:test \
    BUNDLE_DEPLOYMENT=1 \
    RAILS_SERVE_STATIC_FILES=true \
    RAILS_LOG_TO_STDOUT=true \
    TZ=America/New_York \
    LD_PRELOAD=libjemalloc.so.2 \
    MALLOC_CONF=dirty_decay_ms:1000,narenas:2,background_thread:true
COPY --from=runtime-packages /opt/runtime/ /
COPY --from=build /usr/local/bundle /usr/local/bundle
COPY --from=build /rails /rails
COPY --from=build --chown=65532:65532 /runtime-dirs/ /rails/
USER 65532:65532
ENTRYPOINT ["/rails/bin/docker-entrypoint"]
EXPOSE 80
CMD ["./bin/jobs"]
